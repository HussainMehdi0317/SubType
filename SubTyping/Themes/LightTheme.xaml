<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202733" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#657080" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5865F2" />
